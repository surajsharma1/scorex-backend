# ScoreX Backend Environment Variables
MONGODB_URI=mongodb://localhost:27017/scorex
SESSION_SECRET=your-super-secret-session-key-here-change-this
PORT=5000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_live_your_live_key_id_here
RAZORPAY_KEY_SECRET=your_live_key_secret_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Backend URL (for OAuth callback)
BACKEND_URL=http://localhost:5000
